# Copy to .env. Leave secrets empty until you have them.
# Production requires MONGODB_URI and SESSION_SECRET.
# A local demonstration can omit MONGODB_URI when both flags below are true.

MONGODB_URI=
ALLOW_MEMORY_DB=true
SEED_DEMO=true
DEMO_PASSWORD=Galactic-Demo-2026
SESSION_SECRET=replace-this-with-a-long-random-string
PORT=4000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DICOM_DIR=

# Optional Orthanc REST archive. DIMSE stays on Orthanc.
# The workstation calls /api/dicomweb on this API. These credentials stay on the server.
# Use 127.0.0.1 (not [::1]) on Windows. Username/password must match Orthanc RegisteredUsers.
ORTHANC_URL=
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
# Instant ingest: Orthanc Lua OnStoredInstance posts here (see scripts/orthanc-notify.lua).
ORTHANC_WEBHOOK_TOKEN=
ORTHANC_NOTIFY_URL=http://127.0.0.1:4000/api/orthanc/notify
# Backup poller when Lua notify is not installed (milliseconds, min 500).
ORTHANC_POLL_MS=2000
STUDY_EVENT_DELAY_MS=250
# Quiet window before Orthanc is queried to verify a study is finished (15–30s).
TRANSFER_QUIET_MS=20000
# Second Orthanc count must match the first before the study is marked completed.
TRANSFER_VERIFY_GAP_MS=4000
# Set false on the Render web service when pacsd-orthanc-worker runs the poller.
ORTHANC_POLLER=true

# Optional SMTP. Email sharing returns 503 until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PACSD <reports@galactic.example>

# Optional WhatsApp Business Cloud API. When these are empty, Share opens WhatsApp
# Web with the message and does not claim the PDF was sent.
# When set, the API uploads the finalized PDF as a document. If WHATSAPP_TEMPLATE_NAME
# is also set, a failed document upload falls back to that template (patient name, then the share URL).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Medical dictation uses this OpenAI-compatible transcription endpoint.
# The API key stays on the server. Example:
# SPEECH_BASE_URL=https://api.openai.com/v1/audio/transcriptions
# SPEECH_MODEL=gpt-4o-transcribe
# Use gpt-4o-mini-transcribe when cost matters more than the full model.
# An OpenAI host defaults to gpt-4o-mini-transcribe when SPEECH_MODEL is empty.
# Other hosts keep using whisper-1 unless SPEECH_MODEL is set.
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_TIMEOUT_MS=30000
# Set to false only if a compatible server rejects the prompt field.
SPEECH_SEND_PROMPT=true

# Optional OpenAI-compatible chat endpoint. Assist returns 503 until AI_BASE_URL is set.
# AI_API_KEY stays on the server. Do not put it in the Vite client.
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=90000
AI_MAX_IMAGE_SIZE_MB=4
